# 只提供搜索环境，不运行AlphaFold预测；固定公开上游版本。
FROM ghcr.io/sokrypton/colabfold:1.6.2-cuda12
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY oridynamics/__init__.py oridynamics/local_msa.py oridynamics/prepare.py /opt/oridynamics/oridynamics/
ENV PYTHONPATH=/opt/oridynamics
WORKDIR /work
ENTRYPOINT ["python3", "-m", "oridynamics.local_msa"]
